{
    "manifest_version": 3,
    "name": "Web Content Reader",
    "version": "1.1.0",
    "description": "Read webpages aloud with simple controls.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "tts"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_title": "Web Content Reader",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}